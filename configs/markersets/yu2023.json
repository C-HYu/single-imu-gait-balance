    "LFC": "lateral femoral epicondyle", "MFC": "medial femoral epicondyle",
    "TT": "tibial tuberosity", "SHA": "shank (lateral, technical marker)",
    "LMA": "lateral malleolus", "MMA": "medial malleolus",
    "HEE": "heel (calcaneus)", "FOO": "foot (technical marker)", "TOE": "toe (technical marker)",
    "MTH": "first metatarsal head"
  },
